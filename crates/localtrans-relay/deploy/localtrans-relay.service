[Unit]
Description=LocalTrans Relay (discovery + UDP forward)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/localtrans-relay /etc/localtrans-relay.toml
Restart=always
RestartSec=3
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/localtrans-relay.toml

[Install]
WantedBy=multi-user.target
